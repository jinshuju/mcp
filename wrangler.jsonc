{
  // Cloudflare Workers 部署（可选）。服务器无状态：不需要 Durable Objects、KV 或 OAuth Provider。
  "name": "jinshuju-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 对外访问地址（用于 OAuth Protected Resource Metadata 的 resource）。留空则按请求的 Host 推断。
    "JINSHUJU_MCP_PUBLIC_URL": ""
  },
  "observability": { "enabled": true }
}
