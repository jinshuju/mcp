{
  // Workers 风格部署（Cloudflare Workers，或任何兼容的自托管平台如 WDL）。服务器无状态：不需要 Durable Objects、KV 或 OAuth Provider。
  // 对外访问地址通过运行时变量 / secret JINSHUJU_MCP_PUBLIC_URL 提供，不写在这里；逗号分隔可列多个
  // （自定义域名 + 平台默认的带前缀地址），按请求的 Host 选用。不提供时按请求与 X-Forwarded-* 推断，WDL 上推断不出 https 和前缀，务必配置。
  "name": "jinshuju-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "routes": ["mcp.jinshuju.net/*"],
  "wdl": {
    "session_policy": "restart"
  }
}
